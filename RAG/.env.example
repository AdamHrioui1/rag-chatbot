DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
TOP_K=5
# Cosine distance cutoff for a chunk to count as "relevant" (0 = identical
# meaning, 2 = opposite meaning). Calibrated empirically - see README.
SIMILARITY_THRESHOLD=1.3
CHROMA_PATH=chroma

# Must match the Node server's ACCESS_TOKEN_SECRET exactly - both apps
# verify the same JWT independently.
ACCESS_TOKEN_SECRET=generate_a_long_random_string_and_match_the_node_server
JWT_ALGORITHM=HS256
ENABLE_QUERY_EXPANSION=true

# Same MongoDB cluster the Node server uses (see server/.env.example).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB_NAME=test

# Uploaded files live in S3 (see app/services/storage.py), not local disk.
S3_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=eu-north-1

# Local development only - leave unset when running on EC2, which uses
# the instance's attached IAM role instead of an explicit key pair.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

CHUNK_SIZE=1000
CHUNK_OVERLAP=150

MAX_FILE_SIZE_MB=15
ALLOWED_EXTENSIONS=.pdf,.docx,.txt

# Frontend origin(s) allowed to call this API directly from the browser.
CORS_ORIGINS=http://localhost:3000

# Shared secret for the /internal/cleanup-stale-processing maintenance
# endpoint, called periodically by a scheduled Lambda function.
INTERNAL_TASK_SECRET=generate_a_separate_long_random_string
STALE_PROCESSING_MINUTES=30
