PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

GEMINI_API_KEY=your_gemini_api_key

CLIENT_URL=http://localhost:3000

# Where the FastAPI RAG service is reachable FROM THIS SERVER (not from the
# browser). Leave unset for local dev (defaults to http://localhost:8000/chat).
# docker-compose.yml overrides this to http://rag:8000/chat.
# RAG_API_URL=http://localhost:8000/chat

# Must match the RAG service's ACCESS_TOKEN_SECRET exactly.
ACCESS_TOKEN_SECRET=generate_a_long_random_string
ACTIVATION_TOKEN_SECRET=generate_a_long_random_string
REFRESH_TOKEN_SECRET=generate_a_long_random_string

MAILING_SERVICE_CLIENT_ID=
MAILING_SERVICE_CLIENT_SECRET=
MAILING_SERVICE_REFRESH_TOKEN=
SENEDR_EMAIL_ADDRESS=your_email@gmail.com

SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

GOOGLE_SECRET=

CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
